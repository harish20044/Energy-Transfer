# ---- Data & models ----
# Raw datasets are large and externally sourced: fetched via scripts/, never committed.
# Contents are ignored rather than the directories themselves, because git cannot
# re-include a file inside an excluded directory — so .gitkeep would be lost.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
*.csv
*.parquet
*.h5
*.hdf5
!tests/**/*.csv
models/
*.joblib
*.pkl
*.onnx
mlruns/

# ---- Infrastructure ----
.docker/
docker-compose.override.yml
*.tfstate
*.tfstate.*
.terraform/

# ---- Editors ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

