# =============================================================================
# Energy-Transfer — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# Every value here is a safe local-development default EXCEPT the two marked
# CHANGE ME, which must be replaced before anything leaves your machine.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME=energy-transfer
DEBUG=true
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                  # console (human) | json (production)

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated. Must list every origin the browser will call the API from.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL + TimescaleDB ----------------------------------------------
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy_dev_password        # CHANGE ME outside local dev
POSTGRES_DB=energy_transfer
POSTGRES_HOST=postgres                       # `localhost` when running outside Compose
POSTGRES_PORT=5432
# Async driver for the app; Alembic swaps to psycopg internally.
DATABASE_URL=postgresql+asyncpg://energy:energy_dev_password@postgres:5432/energy_transfer

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Authentication ---------------------------------------------------------
# CHANGE ME. Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=dev_only_insecure_secret_change_before_deploying_anywhere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM provider -----------------------------------------------------------
# groq   = default. Free tier, ~275 tok/s, no GPU needed. Needs GROQ_API_KEY.
# ollama = local fallback. Runs on the Windows HOST, not in Compose.
# stub   = deterministic canned responses. Used by CI and all tests.
#
# The LLM never sits in the trading critical path: if it is slow, rate-limited
# or down, explanations degrade but trading and settlement continue untouched.
LLM_PROVIDER=stub

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# host.docker.internal reaches the Windows host from inside a container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_CACHE_TTL_SECONDS=3600

# --- Market rules -----------------------------------------------------------
# Clearing price is bounded to [FEED_IN_TARIFF, RETAIL_TARIFF] so that every
# trade leaves BOTH sides better off than dealing with the utility (objective O6).
MARKET_TICK_MINUTES=15
FEED_IN_TARIFF=3.00                 # what the utility pays a household to export
RETAIL_TARIFF=8.00                  # what the utility charges a household to import
CURRENCY=INR
AUCTION_MECHANISM=uniform           # uniform | pay_as_bid | mid_market_rate

# --- Grid safety ------------------------------------------------------------
GRID_FEEDER=ieee33                  # network model used for the constraint check
TRANSFORMER_CAPACITY_KW=250.0
VOLTAGE_MIN_PU=0.95                 # statutory lower limit (per-unit)
VOLTAGE_MAX_PU=1.05                 # statutory upper limit (per-unit)

# --- Simulator --------------------------------------------------------------
SIM_HOUSEHOLDS=5
SIM_PROSUMER_RATIO=0.6              # fraction of households with solar + battery
SIM_SEED=42                         # fixed seed keeps every run reproducible

# --- Frontend (Vite: only VITE_* vars reach the browser) --------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
